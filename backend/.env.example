# Required: Shared secret for JWT verification (must match frontend Better Auth)
BETTER_AUTH_SECRET=your-secret-here

# Required: PostgreSQL connection string for Neon
NEON_DB_URL=postgresql+asyncpg://user:password@host/database

# Optional: Frontend auth URL (documentation only)
BETTER_AUTH_URL=http://localhost:3000

# Required: Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
